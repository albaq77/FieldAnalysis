{
    "name": "linear_regression",
    "description": "Linear Regression benchmark (Phoenix) - linear_regression_pthread (false sharing) vs linear_regression_pthread_manual (aligned_alloc fix with padding)",
    "source_dir": ".",
    "output_dir": "dfg",
    "default_variant": "lr_pthread",
    "lto": false,
    "multithread": true,
    "simple_access": false,
    "pre_compile": null,
    "input_files": {
        "datafile": "input.txt"
    },
    "output_files": {},
    "trace": {
        "runtime_seconds": 30,
        "flush_threshold": null,
        "sample_rate": 1
    },
    "variants": {
        "lr_pthread": {
            "sources": ["linear_regression_pthread.c"],
            "opt_level": "O1",
            "compile_flags": ["-DTHREADS=4"],
            "link_flags": ["-lpthread"],
            "run_args": ["{datafile}"],
            "multithread": true,
            "pre_compile": null
        },
        "lr_pthread_manual": {
            "sources": ["linear_regression_pthread_manual.c"],
            "opt_level": "O1",
            "compile_flags": [],
            "link_flags": ["-lpthread"],
            "run_args": ["{datafile}"],
            "multithread": true,
            "pre_compile": null
        }
    }
}