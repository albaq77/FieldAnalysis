{
    "name": "boost_test",
    "description": "Boost-like spinlock pool benchmark - spinlock_pool (false sharing) vs spinlock_pool_manual (cache-line aligned fix)",
    "source_dir": ".",
    "output_dir": "dfg",
    "default_variant": "spinlock_pool",
    "lto": false,
    "multithread": true,
    "simple_access": false,
    "pre_compile": null,
    "input_files": {},
    "output_files": {},
    "trace": {
        "runtime_seconds": 30,
        "flush_threshold": null,
        "sample_rate": 1
    },
    "variants": {
        "spinlock_pool": {
            "sources": ["spinlock_pool.cpp"],
            "opt_level": "O1",
            "compile_flags": ["-std=c++11"],
            "link_flags": ["-lpthread"],
            "run_args": ["100"],
            "multithread": true,
            "pre_compile": null
        },
        "spinlock_pool_manual": {
            "sources": ["spinlock_pool_manual.cpp"],
            "opt_level": "O1",
            "compile_flags": ["-std=c++11"],
            "link_flags": ["-lpthread"],
            "run_args": ["100"],
            "multithread": true,
            "pre_compile": null
        }
    }
}