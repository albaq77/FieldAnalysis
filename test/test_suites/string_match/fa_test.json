{
    "name": "string_match",
    "description": "String Match benchmark (Phoenix) - string_match_pthreads (false sharing on MapReduce struct) vs string_match_pthreads_manual (padding fix)",
    "source_dir": ".",
    "output_dir": "dfg",
    "default_variant": "sm_pthread",
    "lto": false,
    "multithread": true,
    "simple_access": false,
    "pre_compile": null,
    "input_files": {
        "datafile": "input.txt"
    },
    "output_files": {},
    "trace": {
        "runtime_seconds": 30,
        "flush_threshold": null,
        "sample_rate": 1
    },
    "variants": {
        "sm_pthread": {
            "sources": ["string_match_pthreads.c"],
            "opt_level": "O2",
            "compile_flags": ["-DTHREADS=4"],
            "link_flags": ["-lpthread", "-lcrypt"],
            "run_args": ["{datafile}"],
            "multithread": true,
            "pre_compile": null
        },
        "sm_pthread_manual": {
            "sources": ["string_match_pthreads_manual.c"],
            "opt_level": "O2",
            "compile_flags": ["-DTHREADS=4"],
            "link_flags": ["-lpthread", "-lcrypt"],
            "run_args": ["{datafile}"],
            "multithread": true,
            "pre_compile": null
        }
    }
}