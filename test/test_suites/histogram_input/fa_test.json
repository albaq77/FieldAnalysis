{
    "name": "histogram_input",
    "description": "Histogram benchmark (Phoenix) with input data - only hist-pthread variant (thread_arg_t without padding, false sharing on red/green/blue arrays in struct)",
    "source_dir": ".",
    "output_dir": "dfg",
    "default_variant": "hist_pthread",
    "lto": false,
    "multithread": true,
    "simple_access": false,
    "pre_compile": null,
    "input_files": {
        "bitmap": "input.bmp"
    },
    "output_files": {},
    "trace": {
        "runtime_seconds": 30,
        "flush_threshold": null,
        "sample_rate": 1
    },
    "variants": {
        "hist_pthread": {
            "sources": ["hist-pthread.c"],
            "opt_level": "O2",
            "compile_flags": [],
            "link_flags": ["-lpthread"],
            "run_args": ["{bitmap}"],
            "multithread": true,
            "pre_compile": null
        }
    }
}